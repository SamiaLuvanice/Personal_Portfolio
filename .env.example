# Copie para .env (ignorado pelo Git) e preencha localmente.
# Na Vercel, cadastre os mesmos nomes em Project → Settings → Environment Variables.
# Atenção: variáveis com prefixo VITE_ vão para o bundle público do navegador.

# Servidor (usadas só pela função api/contact.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Front-end (opcional): base da API. Vazio usa /api, servido pela Vercel e pelo `npm run dev`.
VITE_API_URL=
